APP_NAME=PRODULI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Predis (pure PHP, bukan phpredis) -- portable Windows<->Linux VPS tanpa compile ulang ekstensi.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3/MinIO untuk foto kunjungan kader (docs/planning/02 §5) — isi manual, jangan lewat AI agent.
# AWS_ENDPOINT + AWS_USE_PATH_STYLE_ENDPOINT=true dibutuhkan untuk MinIO (bukan AWS S3 asli).
# TODO(infra): rename MinIO bucket/domain to produli-branded values and update these once done
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
PRODULI_VISIT_PHOTOS_DISK=s3

# Integrasi SiLAKES (docs/planning/04) — isi manual, jangan lewat AI agent
SILAKES_BASE_URL=
SILAKES_API_TOKEN=
# Ability token TERPISAH untuk endpoint tulis pembaruan-lapangan (docs/planning/01 §9) —
# JANGAN samakan dengan SILAKES_API_TOKEN di atas.
SILAKES_WRITE_API_TOKEN=
PRODULI_INTEGRATION_SECRET=

# Login Google (docs/planning/02 §6) — CLIENT_ID/CLIENT_SECRET isi manual, jangan lewat AI agent
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8033/auth/google/callback

SANCTUM_TOKEN_EXPIRATION=30
REFRESH_COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:3000

# 7-layer visit validation (docs/planning/02 §3/§10)
PRODULI_FACE_DETECTION_ENABLED=false
PRODULI_GPS_MAX_ACCURACY_METERS=100
PRODULI_GPS_MAX_AGE_SECONDS=300
PRODULI_GEOFENCE_RADIUS_VERIFIED=150
PRODULI_GEOFENCE_RADIUS_APPROXIMATE=3000
PRODULI_EXIF_MAX_AGE_SECONDS=300
PRODULI_EXIF_GPS_TOLERANCE_METERS=200

# Reminder kader H-1/hari-H (docs/planning/02 §8)
PRODULI_REMINDER_H1_TIME=16:00
PRODULI_REMINDER_SAME_DAY_TIME=06:00

# Kadensi kunjungan berulang (revisi Bu Kadis)
PRODULI_CADENCE_KADER_DAYS=7
PRODULI_CADENCE_TK_DAYS=30
PRODULI_CADENCE_TK_DAYS_BERAT=14

# Smart Early Detection -- ambang proximity (0-1) flag "mendekati Berat" (revisi Bu Kadis)
PRODULI_EARLY_DETECTION_PROXIMITY_THRESHOLD=0.6
# Sinyal combo_breadth (5 parameter kombinasi, revisi Bu Kadis) -- minimal N parameter exceeded
# sekaligus, WAJIB mencakup seluruh nama di COMBO_REQUIRED_PARAMETERS (parameter terpenting
# secara klinis; Cholesterol/Urea jadi pelengkap opsional), DAN seluruhnya >= X% di atas nilai
# rujukan masing-masing baru dianggap "trending ke Berat". MIN_PARAMETERS jangan diset 5 --
# kalau seluruh 5 parameter kombo exceeded bersamaan pasien otomatis sudah Berat (bukan Sedang
# lagi), sinyal ini tidak akan pernah sempat dievaluasi; maksimum yang masih berfungsi adalah 4.
PRODULI_EARLY_DETECTION_COMBO_MIN_PARAMETERS=3
PRODULI_EARLY_DETECTION_COMBO_MARGIN_THRESHOLD_PERCENT=50
PRODULI_EARLY_DETECTION_COMBO_REQUIRED_PARAMETERS="Gula Darah Puasa,LDL,Trigliserida"

# WhatsApp gateway (bot sendiri) — isi manual, jangan lewat AI agent.
# Kontrak: POST {WA_API_BASE_URL}/send/chat-message/{WA_API_KEY} body {phone, message, link_image}.
WA_API_BASE_URL=
WA_API_KEY=

# Firebase Cloud Messaging (push notification) — isi manual, jangan lewat AI agent.
# FIREBASE_CREDENTIALS = path absolut ke service account JSON, simpan di luar public/, jangan
# commit ke git. FIREBASE_WEB_PUSH_VAPID_KEY dipakai FRONTEND (getToken()), dicatat di sini
# biar satu tempat referensi.
FIREBASE_CREDENTIALS=
FIREBASE_WEB_PUSH_VAPID_KEY=

VITE_APP_NAME="${APP_NAME}"
