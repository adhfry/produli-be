<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- PuskesmasGeocodingService: tanpa ini test bulk-geocode nyata menunggu delay rate-limit
             sungguhan (lebih dari 1 detik per puskesmas), bikin suite lambat tanpa manfaat (Nominatim di-fake). -->
        <env name="GEOCODING_RATE_LIMIT_DELAY_MICROSECONDS" value="0"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- RealtimeBroadcastService: tanpa ini nilai .env lokal (http://localhost:4001) ikut
             kepakai di semua test yang memicu notifyReportSubmitted()/notifyPasienDirujuk(),
             bikin test coba HTTP request sungguhan ke produli-wss yang mungkin tidak jalan;
             kosong di sini artinya throw cepat (tertangkap try/catch), test yang memang
             menguji jalur ini set config()/Http::fake() sendiri (lihat tests/Feature/Realtime). -->
        <env name="PRODULI_WSS_BASE_URL" value=""/>
        <env name="WSS_BROADCAST_SECRET" value=""/>
    </php>
</phpunit>
